#### QC 
#Uses porechop to remove primers and adapters from the combined FASTQ file.
#Uses fastcat to filter reads by length (1200–1950 bp) and minimum quality (Q≥10). Saves the final trimmed FASTQ as barcode_XX.trimmed.fastq.
#################################################################################


#!/bin/bash
#!/bin/bash

for barcode in $(seq -w 1 24); do
    INPUT="../combined_fastq_library_f/barcode_${barcode}.combined.fastq"
    OUTPUT="barcode_${barcode}.porechop.fastq"

    echo "#-------------------- Trimming barcode_${barcode} --------------------#"

    if [[ ! -f "$INPUT" ]]; then
        echo "ATTENZIONE: file $INPUT non trovato, salto barcode_${barcode}"
        continue
    fi

    porechop \
        -i "$INPUT" \
        -o "$OUTPUT" \
        --check_reads 1000 \
        --discard_middle \
        --extra_end_trim 0

    echo "Completato barcode_${barcode}"
done


    # Step 2: trimming
for barcode in $(seq -w 1 24); do
    fastcat barcode_${barcode}.porechop.fastq > barcode_${barcode}.trimmed.fastq
done
