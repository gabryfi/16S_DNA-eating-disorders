#!/bin/bash

# Creiamo le cartelle principali per i risultati
mkdir -p bracken_results/bracken_files
mkdir -p bracken_results/bracken_reports

for barcode in $(seq -w 1 24); do
    INPUT="barcode_${barcode}.report.txt"
    OUT_BRACKEN="bracken_results/bracken_files/barcode_${barcode}.bracken"
    OUT_REPORT="bracken_results/bracken_reports/barcode_${barcode}_bracken_report.txt"

    if [[ ! -f "$INPUT" ]]; then
        echo "ATTENZIONE: file $INPUT non trovato, salto barcode_${barcode}"
        continue
    fi

    echo "Starting Bracken on $INPUT..."

    bracken -d /media/user/8Tb/16s_nanopore/ncbi1600 \
            -i "$INPUT" \
            -o "$OUT_BRACKEN" \
            -w "$OUT_REPORT" \
            -r 1500 \
            -l S

    echo "Completato barcode_${barcode}"
done

echo "Tutti i barcode elaborati. I file sono in bracken_results/"

