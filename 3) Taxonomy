#### Taxonomy
# Kraken2 classifies the reads.
# Bracken refines classification into species abundance estimates.

#!/bin/bash

# db building explained in README
# Loop for each barcode of Library XXXX


# Kraken2
# comando lanciato ultime 3 library

for barcode in $(seq -w 1 24); do
    INPUT="porechop_fastq/barcode_${barcode}.porechop.fastq"
    REPORT="barcode_${barcode}.report.txt"
    OUTPUT="barcode_${barcode}.kraken.txt"

    if [[ ! -f "$INPUT" ]]; then
        echo "File $INPUT non trovato, salto barcode_${barcode}"
        continue
    fi

    echo "Classificazione Kraken2 barcode_${barcode}"

    kraken2 \
        --db /media/user/8Tb/16s_nanopore/ncbi1600 \
        --threads 48 \
        --report "$REPORT" \
        "$INPUT" \
        > "$OUTPUT"
done


